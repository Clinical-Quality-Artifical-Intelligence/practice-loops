# Practice Loop run artifacts (local; may contain working clinical/education data)
practice-loop-audit/

# Practice Loop memory records (local; pseudonymised learner trajectories)
practice-loop-memory/*.json
!practice-loop-memory/schema.json

# Word documents and PDFs are kept locally, not published. docs/framework/ ships a
# Markdown twin of every guide, so the .docx were redundant duplicates of published
# content. Note this rule does not retroactively untrack anything already committed —
# the four .docx it was meant to cover stayed public until they were git rm --cached.
# Practice-Loops-for-Nursing-Deck.pptx IS deliberately tracked: it has no Markdown twin.
docs/framework/*.pdf
*.docx

# Word lock/temp files
~$*

# macOS
.DS_Store
._*

# Python bytecode (scripts/ is importable, so running or importing them writes this)
__pycache__/
*.py[cod]

# Editor / tooling
*.swp
.idea/
.vscode/
